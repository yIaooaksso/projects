text = input()
numbers = text.split()

for token in numbers:
    n = int(token)

    summa = 0
    wyras = ""

    for k in range(1, n):
        chislo = k * (k + 1)
        summa = summa + chislo

        if k > 1:
            wyras = wyras + "+"
        wyras = wyras + str(k) + "*" + str(k + 1)

    print(wyras + "=" + str(summa))